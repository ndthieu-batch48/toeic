{
  "configurations": [
    {
      "args": [
        "main:app",
        "--host",
        "192.168.1.17",
        "--port",
        "8000",
        "--reload"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/BACKEND/fastapi",
      "jinja": true,
      "module": "uvicorn",
      "name": "Python Debugger: FastAPI",
      "request": "launch",
      "type": "debugpy"
    },
    {
      "name": "Launch React App (CRA)",
      "request": "launch",
      "runtimeArgs": ["--remote-debugging-port=9223"],
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      },
      "type": "chrome",
      "url": "http://localhost:3000",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "webRoot": "${workspaceFolder}/FRONTEND/client/src"
    }
  ],
  "version": "1.3.0"
}
